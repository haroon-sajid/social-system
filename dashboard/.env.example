# Supabase (public values, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://qpmsrznvleogzjnovsmw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Y2qV_YelMv-MSLCt3VdN2w_8uSt1CKx

# n8n one click publish webhook (server only, never exposed to the browser)
N8N_PUBLISH_WEBHOOK_URL=https://YOUR-N8N-DOMAIN/webhook/social-publish
N8N_WEBHOOK_SECRET_HEADER=x-publish-secret
N8N_WEBHOOK_SECRET=PASTE_A_LONG_RANDOM_STRING

# Facebook Page tokens, one per Page (long-lived Page tokens, setup guide Step 1).
# Only tools/build_credentials_sheet.py reads these: it writes them into n8n/CREDENTIALS.local.md as the n8n credentials
# "Meta Page Token" (Page 1, also used for Instagram) and "Meta Page Token 2" (Page 2). Publishing runs in n8n, so the
# dashboard never uses them: do not add them to Vercel. In Settings > Connected accounts, give each Page its token.
FB_PAGE_1_TOKEN=
FB_PAGE_2_TOKEN=

# Claude app connector check (Settings > Claude API), server only.
# Also used by Draft with Claude > "Terminal window" and "Background", which run Claude Code (the `claude` command)
# on this PC instead of the Claude app. Those two only work when the dashboard runs on your PC, not on Vercel.
# N8N_MCP_URL = Social 0's MCP Server Production URL; N8N_MCP_KEY = exact value of the "Claude MCP Key" credential.
# CLAUDE_CLI = full path to claude.cmd, only if `claude` is not found on the PATH.
# N8N_MCP_URL=https://YOUR-N8N-DOMAIN/mcp/social-mcp-...
# N8N_MCP_KEY_HEADER=x-api-key
# N8N_MCP_KEY=PASTE_THE_SAME_VALUE_AS_IN_CLAUDE

# Claude API (/api/claude/*): your Claude agent sends "Authorization: Bearer <key>".
# Make it 24+ random characters. The API also needs SUPABASE_SERVICE_ROLE_KEY (server only).
# SOCIAL_HUB_API_KEY=PASTE_A_LONG_RANDOM_KEY
# SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Login switch (local only, ignored on Vercel). Uncomment both to skip the login screen on your PC.
# The server then uses the service_role key: Supabase > Project Settings > API Keys > service_role (secret).
# Never put it in a NEXT_PUBLIC_ variable and never add it to Vercel.
# AUTH_DISABLED=true
# SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
