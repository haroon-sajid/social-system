      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Service Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3be6416b-1ef0-5469-85fb-5a31ff279582",
              "leftValue": "={{ $json.published_count }}",
              "operator": {
